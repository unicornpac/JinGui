# Python虚拟环境
.venv/

# Python缓存
__pycache__/
*.pyc
*.pyo
.coverage

# 环境变量（含API密钥）
.env

# 数据库文件（仓库中的 backend/data/tcm.db 仅为首次安装种子快照；
# 生产数据库必须通过 DATA_DIR 存放在仓库外）
*.db
!backend/data/tcm.db

# IDE
.idea/
.vscode/
*.swp
*.swo
backups/

# Runtime uploads live under DATA_DIR and must not be versioned.
backend/uploads/*
!backend/uploads/.gitkeep

# 软著申请材料（本地草稿，不入库）
软件著作权说明书_草稿.md
