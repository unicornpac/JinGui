[Unit]
Description=金匮要略临床思辨训练系统
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/JinGui/backend
EnvironmentFile=-/root/JinGui/backend/.env
Environment=DATA_DIR=/var/lib/jingui
ExecStart=/usr/local/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
